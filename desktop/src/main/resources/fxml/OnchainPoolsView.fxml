<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    Onchain Pools Tab
    ═════════════════
    Browse DEX liquidity pools and their OHLCV data using CoinGecko's
    GeckoTerminal free endpoints:
      - GET /onchain/networks
      - GET /onchain/networks/{n}/pools
      - GET /onchain/networks/trending_pools
      - GET /onchain/networks/{n}/pools/{a}/ohlcv/{tf}
      - GET /onchain/search/pools
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mst.matt.tradingplatformapp.controller.OnchainPoolsController"
      spacing="0"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color:#0d1117;">

    <!-- ══ Header ═══════════════════════════════════════════════════════════ -->
    <VBox spacing="0"
          style="-fx-background-color:#161b22; -fx-border-color:#30363d; -fx-border-width:0 0 1 0;">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🔗 Onchain Pools"
                   style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#e6edf3;"/>
            <Label text="Powered by GeckoTerminal (Free API)"
                   style="-fx-font-size:11px; -fx-text-fill:#8b949e;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshBtn" text="↺ Refresh" onAction="#onRefresh"
                    style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                           -fx-background-radius:6; -fx-padding:6 14;
                           -fx-font-size:12px; -fx-cursor:hand;
                           -fx-border-color:#30363d; -fx-border-radius:6; -fx-border-width:1;"/>
            <ProgressIndicator fx:id="loadingSpinner" prefWidth="20" prefHeight="20"
                               visible="false" managed="false"/>
        </HBox>

        <!-- Controls row -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" bottom="0" left="0" right="0"/></padding>

            <Label text="Network:" style="-fx-text-fill:#8b949e; -fx-font-size:12px;"/>
            <ComboBox fx:id="networkSelector" promptText="Select network"
                      prefWidth="160"
                      style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                             -fx-border-color:#30363d; -fx-border-radius:4; -fx-font-size:12px;"/>

            <Label text="View:" style="-fx-text-fill:#8b949e; -fx-font-size:12px;"/>
            <ToggleButton fx:id="topPoolsBtn" text="Top Pools" selected="true"
                          onAction="#onViewTopPools"
                          style="-fx-background-color:#1f6feb; -fx-text-fill:white;
                                 -fx-background-radius:4; -fx-padding:5 10; -fx-font-size:12px;"/>
            <ToggleButton fx:id="trendingBtn" text="🔥 Trending"
                          onAction="#onViewTrending"
                          style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                                 -fx-background-radius:4; -fx-padding:5 10; -fx-font-size:12px;
                                 -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>

            <Separator orientation="VERTICAL"/>

            <TextField fx:id="searchField" promptText="Search pool or token…" prefWidth="200"
                       style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                              -fx-border-color:#30363d; -fx-border-radius:4;
                              -fx-background-radius:4; -fx-padding:5 10; -fx-font-size:12px;"/>
            <Button text="🔍" onAction="#onSearchPools"
                    style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;
                           -fx-background-radius:4; -fx-padding:5 10;
                           -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
        </HBox>

        <Label fx:id="lastUpdateLabel" text="Last updated: —"
               style="-fx-text-fill:#484f58; -fx-font-size:10px; -fx-padding:4 0 0 0;"/>
    </VBox>

    <!-- ══ Main layout (two-panel) ═══════════════════════════════════════ -->
    <HBox spacing="16" VBox.vgrow="ALWAYS" style="-fx-background-color:#0d1117;">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <!-- ── Left: Pools list ────────────────────────────────────────── -->
        <VBox spacing="8" prefWidth="480" minWidth="340">
            <Label text="💧 Pools"
                   style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#e6edf3;"/>

            <VBox spacing="0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color:#161b22; -fx-background-radius:8;
                         -fx-border-color:#30363d; -fx-border-radius:8; -fx-border-width:1;">

                <!-- Table header -->
                <HBox spacing="0"
                      style="-fx-background-color:#21262d; -fx-background-radius:8 8 0 0;
                             -fx-padding:7 12; -fx-border-color:#30363d; -fx-border-width:0 0 1 0;">
                    <Label text="Pool" HBox.hgrow="ALWAYS"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Price USD" prefWidth="100" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Liquidity" prefWidth="100" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent; -fx-background:transparent;">
                    <VBox fx:id="poolsContainer" spacing="0">
                        <!-- Pool rows injected dynamically -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Pagination -->
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Label fx:id="pageLabel" text="Page 1"
                       style="-fx-text-fill:#8b949e; -fx-font-size:11px;"/>
                <Button fx:id="prevPageBtn" text="◀" onAction="#onPrevPage"
                        style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                               -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;
                               -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
                <Button fx:id="nextPageBtn" text="▶" onAction="#onNextPage"
                        style="-fx-background-color:#21262d; -fx-text-fill:#e6edf3;
                               -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;
                               -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
            </HBox>
        </VBox>

        <!-- ── Right: Pool detail + OHLCV ─────────────────────────────── -->
        <VBox spacing="12" HBox.hgrow="ALWAYS">

            <!-- Pool info panel -->
            <VBox fx:id="poolDetailPanel" spacing="10"
                  style="-fx-background-color:#161b22; -fx-background-radius:8;
                         -fx-border-color:#30363d; -fx-border-radius:8; -fx-border-width:1;">
                <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔗" style="-fx-font-size:20px;"/>
                    <VBox spacing="2">
                        <Label fx:id="poolNameLabel" text="Select a pool"
                               style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#e6edf3;"/>
                        <Label fx:id="poolAddressLabel" text="—"
                               style="-fx-font-size:10px; -fx-text-fill:#484f58;"/>
                    </VBox>
                </HBox>

                <HBox spacing="20">
                    <VBox spacing="2">
                        <Label text="PRICE (USD)" style="-fx-font-size:10px; -fx-text-fill:#8b949e;"/>
                        <Label fx:id="poolPriceLabel" text="—"
                               style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#3fb950;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="LIQUIDITY" style="-fx-font-size:10px; -fx-text-fill:#8b949e;"/>
                        <Label fx:id="poolLiquidityLabel" text="—"
                               style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#e6edf3;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="VOLUME 24H" style="-fx-font-size:10px; -fx-text-fill:#8b949e;"/>
                        <Label fx:id="poolVolumeLabel" text="—"
                               style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#58a6ff;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="NETWORK" style="-fx-font-size:10px; -fx-text-fill:#8b949e;"/>
                        <Label fx:id="poolNetworkLabel" text="—"
                               style="-fx-font-size:14px; -fx-text-fill:#8b949e;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- OHLCV controls -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Timeframe:" style="-fx-text-fill:#8b949e; -fx-font-size:12px;"/>
                <ToggleButton fx:id="tfMinute" text="1m" onAction="#onTimeframeChange" userData="minute|1"
                              style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;
                                     -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;
                                     -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
                <ToggleButton fx:id="tfHour" text="1h" onAction="#onTimeframeChange" userData="hour|1" selected="true"
                              style="-fx-background-color:#1f6feb; -fx-text-fill:white;
                                     -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;"/>
                <ToggleButton fx:id="tf4Hour" text="4h" onAction="#onTimeframeChange" userData="hour|4"
                              style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;
                                     -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;
                                     -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
                <ToggleButton fx:id="tfDay" text="1d" onAction="#onTimeframeChange" userData="day|1"
                              style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;
                                     -fx-background-radius:4; -fx-padding:3 8; -fx-font-size:11px;
                                     -fx-border-color:#30363d; -fx-border-radius:4; -fx-border-width:1;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="loadOhlcvBtn" text="Load OHLCV" onAction="#onLoadPoolOhlcv"
                        style="-fx-background-color:#21262d; -fx-text-fill:#58a6ff;
                               -fx-background-radius:4; -fx-padding:3 10;
                               -fx-border-color:#1f6feb; -fx-border-radius:4; -fx-border-width:1;
                               -fx-font-size:11px; -fx-cursor:hand;"/>
            </HBox>

            <!-- OHLCV mini-table -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color:#161b22; -fx-background-radius:8;
                         -fx-border-color:#30363d; -fx-border-radius:8; -fx-border-width:1;">

                <HBox spacing="0"
                      style="-fx-background-color:#21262d; -fx-background-radius:8 8 0 0;
                             -fx-padding:7 12; -fx-border-color:#30363d; -fx-border-width:0 0 1 0;">
                    <Label text="Time" prefWidth="140"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Open" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="High" prefWidth="90" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Low" prefWidth="90" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Close" prefWidth="90" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                    <Label text="Volume" prefWidth="100" alignment="CENTER_RIGHT"
                           style="-fx-font-size:10px; -fx-font-weight:bold; -fx-text-fill:#8b949e;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent; -fx-background:transparent;">
                    <VBox fx:id="ohlcvContainer" spacing="0">
                        <!-- OHLCV rows injected dynamically -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Status -->
            <Label fx:id="statusLabel" text="Select a pool to view OHLCV data."
                   style="-fx-text-fill:#8b949e; -fx-font-size:11px;"/>
        </VBox>

    </HBox>

</VBox>
