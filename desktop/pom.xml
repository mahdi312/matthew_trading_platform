<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mst.matt</groupId>
    <artifactId>TradingPlatformApp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>TradingPlatformApp</name>
    <description>TradingPlatformApp — thin JavaFX client for the trading platform microservices</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.2</javafx.version>
        <!--
            REMOVED in Phase 2, Step 12 (thin-client refactor):
              ta4j-core          — indicator maths moved to market-service / ai-service
              poi-ooxml          — Excel export moved to trading-service (ReportingController)
              sqlite-jdbc        — desktop no longer has a local database
              hibernate-community-dialects — no Hibernate in thin client
              telegrambots / telegrambots-spring-boot-starter — notifications via alert-service WS
              spring-boot-starter-data-jpa — all JPA removed
              spring-boot-starter-mail     — notifications via notification-service
              postgresql                   — no direct DB access
        -->
        <okhttp.version>4.12.0</okhttp.version>
        <gson.version>2.10.1</gson.version>
        <lombok.version>1.18.34</lombok.version>
        <fxweaver.version>2.0.1</fxweaver.version>
        <!-- T-20: console window suppressed by default for release.
             Toggle with -Dwinconsole=true for debugging on Windows. -->
        <winconsole>false</winconsole>
    </properties>

    <dependencies>

        <!-- ═══════════════════════════════════════════ -->
        <!--           SPRING BOOT CORE                 -->
        <!-- ═══════════════════════════════════════════ -->
        <!--
            spring-boot-starter provides Spring DI, @Configuration, @Value, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            TRANSITIONAL (Step 12 in-progress):
            spring-boot-starter-data-jpa, sqlite-jdbc, hibernate-community-dialects,
            and postgresql are retained here while the domain-by-domain migration of
            controllers to the Gateway API clients is in progress.  Each dependency
            below is tagged with the step that will remove it:

              • spring-boot-starter-data-jpa    — remove when ALL controllers are migrated
              • sqlite-jdbc + hibernate dialects — remove with JPA
              • postgresql                       — remove with JPA
              • spring-boot-starter-mail         — remove when notification-service handles email
              • telegrambots + spring-starter     — remove when alert-service WS client is wired
              • poi-ooxml                         — remove when Excel export uses trading-service
              • ta4j-core                         — remove when indicator compute moves to market/ai-service

            DO NOT remove these until the corresponding controller / service file
            no longer imports any JPA / Spring Data annotation.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- TODO Step 12 (remaining domains): remove once all repositories are deleted -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <!-- TODO: remove once notification-service handles all email -->
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--   DATABASE: SQLite + Hibernate (TRANSITIONAL) -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
            <!-- TODO: remove with spring-boot-starter-data-jpa -->
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>6.5.3.Final</version>
            <!-- TODO: remove with spring-boot-starter-data-jpa -->
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <!-- TODO: remove with spring-boot-starter-data-jpa -->
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--   TELEGRAM BOT (TRANSITIONAL)              -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots</artifactId>
            <version>6.9.7.1</version>
            <!-- TODO: remove when alert-service STOMP push replaces TelegramBot -->
        </dependency>
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots-spring-boot-starter</artifactId>
            <version>6.9.7.1</version>
            <!-- TODO: remove when alert-service STOMP push replaces TelegramBot -->
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--   EXCEL EXPORT (TRANSITIONAL)              -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
            <!-- TODO: remove when Excel export moves to trading-service/ReportingController -->
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--   TECHNICAL ANALYSIS (TRANSITIONAL)        -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.ta4j</groupId>
            <artifactId>ta4j-core</artifactId>
            <version>0.22.1</version>
            <!-- TODO: remove when indicator compute moves to market-service / ai-service -->
        </dependency>

        <!-- BCrypt password hashing — retained for any local auth fallback during transition -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <!-- TODO: remove once AuthService delegates fully to identity-service -->
        </dependency>

        <!--
            WebFlux gives us WebClient for reactive, non-blocking HTTP calls to
            the Gateway.  We use it in blocking mode (WebClient#block()) from
            virtual threads so the JavaFX event loop is never stalled.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
            Jackson ObjectMapper is required by WebClient for JSON serialisation /
            deserialisation of gateway request/response bodies.  It is pulled in
            transitively by spring-boot-starter-webflux; listed here explicitly
            so the version is clear.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--       STOMP / WebSocket client             -->
        <!-- ═══════════════════════════════════════════ -->
        <!--
            Used by the STOMP subscription layer that connects to:
              • market-service  STOMP endpoint (/ws-market) for live price ticks
              • alert-service   STOMP endpoint (/ws)         for in-app alert notifications
            Replaces the old direct Binance WebSocket + TelegramBot + NotificationService.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ===================== JAXB (Fix for Java 21) ===================== -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.2</version>
        </dependency>
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>4.0.5</version>
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--           JAVAFX MODULES                   -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- FxWeaver: Spring DI bridge for JavaFX FXML controllers -->
        <dependency>
            <groupId>net.rgielen</groupId>
            <artifactId>javafx-weaver-spring-boot-starter</artifactId>
            <version>${fxweaver.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--           HTTP CLIENT (legacy OkHttp)      -->
        <!-- ═══════════════════════════════════════════ -->
        <!--
            OkHttp + Gson are retained for the existing market-data provider
            classes (AlphaVantage, Finnhub, CoinGecko, etc.) that have NOT yet
            been migrated to use the Gateway.  They will be removed one provider
            at a time as each domain is migrated to the corresponding service.
        -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--           UTILITIES                        -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ═══════════════════════════════════════════ -->
        <!--           TEST                             -->
        <!-- ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Fail fast when JAVA_HOME is below 21 (Spring Boot 3 requirement) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>
                                        TradingPlatformApp requires JDK 21 or newer.
                                        Install JDK 21+, set JAVA_HOME to it, then run mvn again.
                                        Use the same JDK as your IDE (Project SDK / java.version 21).
                                    </message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.mst.matt.tradingplatformapp.TradingPlatformAppApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <mainClass>com.mst.matt.tradingplatformapp.TradingPlatformAppApplication</mainClass>
                    <jvmArguments>
                        --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens javafx.base/com.sun.javafx.runtime=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Run tests with the same JDK that compiles -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!-- jpackage — native installer -->
            <plugin>
                <groupId>com.github.akman</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>0.1.5</version>
                <configuration>
                    <name>MatthewTradingPlatform</name>
                    <appversion>1.0.0</appversion>
                    <vendor>TradingPlatform</vendor>
                    <description>developed by Mahdi Mostafavi</description>
                    <description>Professional Trading Journal with AI Analysis</description>
                    <copyright>2026 TradingPlatform</copyright>

                    <!-- Entry point -->
                    <mainclass>com.mst.matt.tradingplatformapp.TradingPlatformAppApplication</mainclass>
                    <mainjar>${project.build.finalName}.jar</mainjar>

                    <!-- Input directory with the fat JAR -->
                    <input>${project.build.directory}</input>

                    <!-- Output directory -->
                    <dest>${project.build.directory}/installer</dest>

                    <!-- Platform-specific settings -->
                    <type>EXE</type>

                    <javaoptions>--add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens=javafx.base/com.sun.javafx.runtime=ALL-UNNAMED
                        -Xmx1024m</javaoptions>

                    <!-- Windows-specific -->
                    <!-- T-20: hidden console for release builds.
                         Override with -Dwinconsole=true for debugging on Windows. -->
                    <winconsole>${winconsole}</winconsole>
                    <windirchooser>true</windirchooser>
                    <winshortcut>true</winshortcut>
                    <winmenu>true</winmenu>
                    <winmenugroup>Trading Platform</winmenugroup>

                    <icon>${project.basedir}/src/main/resources/icons/icon.ico</icon>

                    <!-- macOS-specific -->
                    <macsign>false</macsign>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
