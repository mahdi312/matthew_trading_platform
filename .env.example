# ── Matthew Trading Platform — environment template ─────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env` to source control.
#
#   cp .env.example .env

# ── PostgreSQL (shared instance, per-service databases) ───────────────────────
POSTGRES_USER=mtp
POSTGRES_PASSWORD=mtp_secret
POSTGRES_DB=mtp

# ── Config Server ─────────────────────────────────────────────────────────────
CONFIG_SERVER_URI=http://localhost:8888

# ── JWT (must match across gateway-service and identity-service) ─────────────
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_EXPIRATION_SECONDS=86400

# ── Google OAuth2 (identity-service) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── market-service — market-data provider API keys ───────────────────────────
ALPHAVANTAGE_KEY=
COINGECKO_KEY=
COINMARKETCAP_KEY=
POLYGON_KEY=
MARKETSTACK_KEY=
FINNHUB_KEY=
TWELVEDATA_KEY=
FIXERIO_KEY=
FREECURRENCYAPI_KEY=
CURRENCYLAYER_KEY=
EXCHANGERATEAPI_KEY=
OPENEXCHANGERATES_KEY=

# Desktop monolith only — no microservice provider wired yet
# FRED_KEY=

# ── market-service / trading-service — BitUnix broker ────────────────────────
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# ── market-service — optional provider URL overrides ───────────────────────────
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FALLBACK_URL=https://data-api.binance.vision
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
YAHOO_BASE_URL=https://query1.finance.yahoo.com
FRANKFURTER_BASE_URL=https://api.frankfurter.app
BITUNIX_REST_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC_URL=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE_URL=wss://fapi.bitunix.com/private/

# ── market-service — cache / sync tuning ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_CAFFEINE_OHLCV_TTL_SECONDS=30
CACHE_CAFFEINE_TICKER_TTL_SECONDS=5
CACHE_REDIS_OHLCV_TTL_MINUTES=5
CACHE_REDIS_TICKER_TTL_SECONDS=10
MARKET_SYNC_ENABLED=false
MARKET_HTTP_CONNECT_TIMEOUT=5
MARKET_HTTP_READ_TIMEOUT=15
MARKET_HTTP_CALL_TIMEOUT=30

# ── reference-data-service — cache tuning ────────────────────────────────────
CACHE_CAFFEINE_NEWS_TTL_SECONDS=120
CACHE_CAFFEINE_FUNDAMENTALS_TTL_SECONDS=300
CACHE_CAFFEINE_SENTIMENT_TTL_SECONDS=60
CACHE_CAFFEINE_CALENDAR_TTL_SECONDS=300
CACHE_CAFFEINE_SEARCH_TTL_SECONDS=60
CACHE_CAFFEINE_NFT_TTL_SECONDS=120
CACHE_REDIS_NEWS_TTL_MINUTES=10
CACHE_REDIS_FUNDAMENTALS_TTL_MINUTES=60
CACHE_REDIS_SENTIMENT_TTL_MINUTES=5
CACHE_REDIS_CALENDAR_TTL_MINUTES=60
CACHE_REDIS_SEARCH_TTL_MINUTES=30
CACHE_REDIS_NFT_TTL_MINUTES=15

# ── Kafka (trading-service, alert-service, notification-service) ─────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── notification-service — SMTP email ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# ── notification-service — Telegram bot ──────────────────────────────────────
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TradingBot
TELEGRAM_BOT_CHAT_IDS=

# ── ai-service — LLM provider keys ───────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ── alert-service — evaluation loop ──────────────────────────────────────────
ALERT_POLL_INTERVAL_MS=10000

# ── Internal service URLs (optional; Eureka used when blank) ───────────────────
IDENTITY_SERVICE_URL=
REFERENCE_DATA_SERVICE_URL=

# ── frontend (Docker) — browser-reachable Gateway URL ────────────────────────
GATEWAY_BASE_URL=http://localhost:8080
